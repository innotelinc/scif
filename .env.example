# Docker Compose backend environment. Replace placeholders before starting services.
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
SCIF_JWT_SECRET=replace-with-at-least-32-random-bytes
APP_ORIGINS=http://localhost:5173,capacitor://localhost,http://localhost
API_BIND_ADDRESS=127.0.0.1
API_HOST_PORT=18080

# Frontend build-time API endpoint. Keep local during development; use public HTTPS for release.
VITE_API_BASE_URL=http://localhost:8080/api/v1
